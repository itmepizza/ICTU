diff --git a/src/lib/logic.js b/src/lib/logic.js
index 8fee5e5..adf3aca 100644
--- a/src/lib/logic.js
+++ b/src/lib/logic.js
@@ -115,3 +115,34 @@ export const extractSourceTag = (content) => {
   const m = content.match(/[Đđ]iều\s*(\d+)/);
   return m ? `Mục ${m[1]} — Nội quy KTX` : 'Dựa trên Nội quy KTX';
 };
+
+// ===== AI — dữ liệu gửi cho Gemini (IssuesView handleSummarize / RegisterHousingModal handleAISuggest) =====
+// LƯU Ý PHẠM VI: các hàm dưới đây chỉ đóng gói ĐÚNG dữ liệu trước khi gửi cho AI — không unit-test
+// được việc AI "gom nhóm" hay "gợi ý" ra sao, vì đó là kết quả suy luận của Gemini (gọi qua mạng),
+// nằm ngoài khả năng unit test phía client. Đây là phần logic THUẦN duy nhất có thể tách/test được
+// trong 2 tính năng AI này.
+
+// "Tòa A1, tầng 4, phòng R103" — có cột mới thì dùng, phản ánh cũ thiếu cột thì hiện mã phòng cũ.
+export const locationLabel = (issue) => {
+  if (issue.buildings?.name && issue.floor && issue.room_number) {
+    return `${issue.buildings.name}, tầng ${issue.floor}, phòng ${issue.room_number}`;
+  }
+  return issue.room_id || issue.room_number || '—';
+};
+
+// Payload phòng trống gửi cho AI gợi ý xếp phòng — đúng field/shape đưa vào prompt.
+export const buildRoomSuggestPayload = (vacantRooms) =>
+  vacantRooms.map((r) => ({
+    room_number: r.room_number,
+    building: r.buildings?.name,
+    capacity: r.capacity,
+    occupied: r.occ,
+    gender: r.gender,
+    type: r.type,
+    description: r.description || null,
+  }));
+
+// Payload danh sách phản ánh gửi cho AI tóm tắt. Việc gom nhóm theo danh mục (Cơ sở vật chất,
+// Điện nước...) do Gemini thực hiện dựa trên systemPrompt, không có bước gom nhóm phía client.
+export const buildIssueSummaryPayload = (issues) =>
+  issues.map((i) => ({ location: locationLabel(i), noi_dung: i.title, status: i.status }));

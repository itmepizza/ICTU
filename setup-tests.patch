 });
+
+// Ghi chú phạm vi: 3 hàm dưới đây chỉ đóng gói dữ liệu gửi cho Gemini (handleAISuggest /
+// handleSummarize) — KHÔNG test được việc AI gợi ý phòng nào hay gom nhóm phản ánh ra sao, vì đó
+// là suy luận của Gemini qua mạng, ngoài phạm vi unit test. Đây là phần logic thuần duy nhất tách
+// được ở 2 tính năng AI này.
+describe('locationLabel', () => {
+  it('có đủ tòa/tầng/phòng thì ghép đầy đủ', () => {
+    const issue = { buildings: { name: 'Tòa A1' }, floor: 4, room_number: 'R103' };
+    expect(locationLabel(issue)).toBe('Tòa A1, tầng 4, phòng R103');
+  });
+
+  it('phản ánh cũ thiếu building/floor thì fallback về room_id', () => {
+    expect(locationLabel({ room_id: 'R101' })).toBe('R101');
+  });
+
+  it('thiếu cả building/floor lẫn room_id thì fallback về room_number', () => {
+    expect(locationLabel({ room_number: 'R101' })).toBe('R101');
+  });
+
+  it('không có gì thì trả về "—"', () => {
+    expect(locationLabel({})).toBe('—');
+  });
+});
+
+describe('buildRoomSuggestPayload', () => {
+  it('đúng field/shape gửi cho AI gợi ý xếp phòng', () => {
+    const vacantRooms = [
+      { room_number: 'R101', buildings: { name: 'Tòa A1' }, capacity: 4, occ: 2, gender: 'Nam', type: 'Phòng tiêu chuẩn', description: 'Yên tĩnh' },
+    ];
+    expect(buildRoomSuggestPayload(vacantRooms)).toEqual([
+      { room_number: 'R101', building: 'Tòa A1', capacity: 4, occupied: 2, gender: 'Nam', type: 'Phòng tiêu chuẩn', description: 'Yên tĩnh' },
+    ]);
+  });
+
+  it('thiếu buildings/description thì trả về undefined/null tương ứng, không lỗi', () => {
+    const vacantRooms = [{ room_number: 'R102', capacity: 2, occ: 0, gender: 'Nữ', type: 'Phòng cao cấp' }];
+    const result = buildRoomSuggestPayload(vacantRooms);
+    expect(result[0].building).toBeUndefined();
+    expect(result[0].description).toBeNull();
+  });
+
+  it('mảng rỗng thì trả về mảng rỗng', () => {
+    expect(buildRoomSuggestPayload([])).toEqual([]);
+  });
+});
+
+describe('buildIssueSummaryPayload', () => {
+  it('đúng field/shape gửi cho AI tóm tắt, location dùng locationLabel', () => {
+    const issues = [
+      { buildings: { name: 'Tòa A1' }, floor: 2, room_number: 'R101', title: 'Hỏng bóng đèn', status: 'Chờ xử lý' },
+      { room_id: 'R202', title: 'Nước yếu', status: 'Đang giải quyết' },
+    ];
+    expect(buildIssueSummaryPayload(issues)).toEqual([
+      { location: 'Tòa A1, tầng 2, phòng R101', noi_dung: 'Hỏng bóng đèn', status: 'Chờ xử lý' },
+      { location: 'R202', noi_dung: 'Nước yếu', status: 'Đang giải quyết' },
+    ]);
+  });
+
+  it('mảng rỗng thì trả về mảng rỗng', () => {
+    expect(buildIssueSummaryPayload([])).toEqual([]);
+  });
+});
